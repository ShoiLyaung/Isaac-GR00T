{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groot.local/schemas/codec-evidence-full-fixture-manifest-v1.schema.json",
  "title": "Codec Evidence Full Fixture Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "complete",
    "coverage_kind",
    "camera_id",
    "source_kind",
    "expected_episode_count",
    "covered_episode_count",
    "covered_episode_uids",
    "covered_episode_uid_digest",
    "input_snapshot_sha256",
    "budget_sha256",
    "codec_contract",
    "codec_contract_sha256",
    "objects",
    "producer_identity"
  ],
  "properties": {
    "schema_version": {"const": "codec-evidence-full-fixture-manifest-v1"},
    "fixture_id": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
    "complete": {"const": true},
    "coverage_kind": {"const": "FULL_EPISODE_SET"},
    "camera_id": {"const": "cam_left_high"},
    "source_kind": {"const": "NATIVE_CANONICAL_DECODED_DERIVED"},
    "expected_episode_count": {"type": "integer", "minimum": 1},
    "covered_episode_count": {"type": "integer", "minimum": 1},
    "covered_episode_uids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "https://groot.local/schemas/codec-evidence-full-fixture-manifest-v1.schema.json#/$defs/sha256"}
    },
    "covered_episode_uid_digest": {"$ref": "https://groot.local/schemas/codec-evidence-full-fixture-manifest-v1.schema.json#/$defs/sha256"},
    "input_snapshot_sha256": {"$ref": "https://groot.local/schemas/codec-evidence-full-fixture-manifest-v1.schema.json#/$defs/sha256"},
    "budget_sha256": {"$ref": "https://groot.local/schemas/codec-evidence-full-fixture-manifest-v1.schema.json#/$defs/sha256"},
    "codec_contract": {
      "allOf": [
        {"$ref": "codec-evidence-global-contract-v1.schema.json"},
        {
          "required": ["fixture_mode", "camera_id", "source_kind"],
          "properties": {
            "fixture_mode": {"const": "PRODUCTION_NATIVE_CANONICAL"},
            "camera_id": {"const": "cam_left_high"},
            "source_kind": {"const": "NATIVE_CANONICAL_DECODED_DERIVED"}
          }
        }
      ]
    },
    "codec_contract_sha256": {"$ref": "https://groot.local/schemas/codec-evidence-full-fixture-manifest-v1.schema.json#/$defs/sha256"},
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "episode_uid",
          "camera_id",
          "source_kind",
          "num_frames",
          "derivation_sha256",
          "object_content_sha256",
          "bundle_manifest_sha256",
          "bundle_manifest_bytes"
        ],
        "properties": {
          "episode_uid": {"$ref": "https://groot.local/schemas/codec-evidence-full-fixture-manifest-v1.schema.json#/$defs/sha256"},
          "camera_id": {"const": "cam_left_high"},
          "source_kind": {"const": "NATIVE_CANONICAL_DECODED_DERIVED"},
          "num_frames": {"type": "integer", "minimum": 1},
          "derivation_sha256": {"$ref": "https://groot.local/schemas/codec-evidence-full-fixture-manifest-v1.schema.json#/$defs/sha256"},
          "object_content_sha256": {"$ref": "https://groot.local/schemas/codec-evidence-full-fixture-manifest-v1.schema.json#/$defs/sha256"},
          "bundle_manifest_sha256": {"$ref": "https://groot.local/schemas/codec-evidence-full-fixture-manifest-v1.schema.json#/$defs/sha256"},
          "bundle_manifest_bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "producer_identity": {"type": "object", "minProperties": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
